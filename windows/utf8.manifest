<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- The player's narrow strings are UTF-8 (SDL, file dialogs, Known Folders). Make that the
     process code page, so fopen, ifstream and std::filesystem::path read them correctly on a
     Windows user name or folder outside the system's ANSI code page. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
