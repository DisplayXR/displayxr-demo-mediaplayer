#include <winver.h>

// Media Player Pro is the same trunk built with MEDIAPLAYER_PRO=1 (docs/PRO.md); CMake
// passes the target's compile definitions to the resource compiler too.
#if MEDIAPLAYER_PRO
#define MP_RC_DESCRIPTION  "DisplayXR Media Player Pro"
#define MP_RC_INTERNAL     "mediaplayer_pro_handle_vk_win"
#define MP_RC_ORIGINAL     "mediaplayer_pro_handle_vk_win.exe"
#else
#define MP_RC_DESCRIPTION  "DisplayXR Media Player"
#define MP_RC_INTERNAL     "mediaplayer_handle_vk_win"
#define MP_RC_ORIGINAL     "mediaplayer_handle_vk_win.exe"
#endif

// Explorer/file icon — multi-size .ico generated from the 2D workspace
// logo (displayxr/icon.png, Pro: icon_pro.png); the SBS 3D logo stays shell-only.
#if MEDIAPLAYER_PRO
1 ICON "../displayxr/icon_pro.ico"
#else
1 ICON "../displayxr/icon.ico"
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "The DisplayXR Project"
            VALUE "FileDescription",  MP_RC_DESCRIPTION
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     MP_RC_INTERNAL
            VALUE "LegalCopyright",   "Copyright 2026 The DisplayXR Project and its contributors"
            VALUE "OriginalFilename", MP_RC_ORIGINAL
            VALUE "ProductName",      MP_RC_DESCRIPTION
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
